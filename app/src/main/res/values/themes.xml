<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Светлая тема (по умолчанию) -->
    <style name="Theme.Calculator" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/surface_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorError">@color/error</item>

        <item name="calculatorScreenBackground">@drawable/bg_screen</item>
        <item name="calculatorDigitBackground">@color/key_digit_light</item>
        <item name="calculatorDigitText">@color/text_primary_light</item>
        <item name="calculatorOperatorBackground">@color/key_operator_light</item>
        <item name="calculatorOperatorText">@color/brand_primary</item>
        <item name="calculatorActionBackground">@color/key_action_light</item>
        <item name="calculatorActionText">@color/brand_primary_dark</item>

        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor" tools:targetApi="l">?attr/colorSurface</item>
    </style>

    <!-- Тёмная тема: выбирается в настройках или системой (values-night). -->
    <style name="Theme.Calculator.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand_primary_light</item>
        <item name="colorPrimaryVariant">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorSecondary">@color/accent_light</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorError">@color/error</item>

        <item name="calculatorScreenBackground">@drawable/bg_screen</item>
        <item name="calculatorDigitBackground">@color/key_digit_dark</item>
        <item name="calculatorDigitText">@color/text_primary_dark</item>
        <item name="calculatorOperatorBackground">@color/key_operator_dark</item>
        <item name="calculatorOperatorText">@color/brand_primary_light</item>
        <item name="calculatorActionBackground">@color/key_action_dark</item>
        <item name="calculatorActionText">@color/accent_light</item>

        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor" tools:targetApi="l">?attr/colorSurface</item>
    </style>

    <!-- Совместимость со старым кодом/настройками -->
    <style name="Theme_CalculatorDark" parent="Theme.Calculator.Dark" />

    <style name="Theme.Calculator.Settings" parent="Theme.Calculator" />

</resources>
