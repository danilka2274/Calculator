<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ============ Текстовые стили ============ -->

    <style name="Widget.Calculator.Text.Result" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_gravity">end</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:paddingStart">@dimen/result_padding_h</item>
        <item name="android:paddingEnd">@dimen/result_padding_h</item>
        <item name="android:paddingTop">@dimen/result_padding_v</item>
        <item name="android:paddingBottom">@dimen/result_padding_v</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/text_result</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="app:autoSizeTextType">uniform</item>
        <item name="app:autoSizeMinTextSize">@dimen/text_result_min</item>
        <item name="app:autoSizeMaxTextSize">@dimen/text_result</item>
        <item name="app:autoSizeStepGranularity">2sp</item>
        <item name="android:minHeight">@dimen/result_min_height</item>
    </style>

    <style name="Widget.Calculator.Text.Preview" parent="Widget.MaterialComponents.TextView">
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:paddingStart">@dimen/result_padding_h</item>
        <item name="android:paddingEnd">@dimen/result_padding_h</item>
        <item name="android:paddingBottom">@dimen/preview_padding_bottom</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">@dimen/text_preview</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">start</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- ============ Клавиатура ============ -->

    <style name="Widget.Calculator.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:baselineAligned">false</item>
    </style>

    <style name="Widget.Calculator.Button.Base" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/button_margin</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">@dimen/button_corner</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <!-- Цифры -->
    <style name="Widget.Calculator.Button.Digit" parent="Widget.Calculator.Button.Base">
        <item name="backgroundTint">?attr/calculatorDigitBackground</item>
        <item name="android:textColor">?attr/calculatorDigitText</item>
    </style>

    <!-- Операции: + − × ÷ -->
    <style name="Widget.Calculator.Button.Operator" parent="Widget.Calculator.Button.Base">
        <item name="backgroundTint">?attr/calculatorOperatorBackground</item>
        <item name="android:textColor">?attr/calculatorOperatorText</item>
        <item name="android:textSize">@dimen/text_button_operator</item>
    </style>

    <!-- Служебные: C, ⌫, скобки, √, %, ± -->
    <style name="Widget.Calculator.Button.Action" parent="Widget.Calculator.Button.Base">
        <item name="backgroundTint">?attr/calculatorActionBackground</item>
        <item name="android:textColor">?attr/calculatorActionText</item>
        <item name="android:textSize">@dimen/text_button_operator</item>
    </style>

    <!-- «=» -->
    <style name="Widget.Calculator.Button.Equals" parent="Widget.Calculator.Button.Base">
        <item name="backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:textSize">@dimen/text_button_operator</item>
    </style>

    <!-- Верхняя панель -->
    <style name="Widget.Calculator.Button.Toolbar" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_margin">@dimen/button_margin</item>
        <item name="android:minHeight">@dimen/toolbar_button_height</item>
        <item name="android:textSize">@dimen/text_toolbar</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="cornerRadius">@dimen/button_corner</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="iconSize">@dimen/icon_size</item>
    </style>

</resources>
